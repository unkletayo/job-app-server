generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  candidateProfile CandidateProfile?
  jobPreferences   JobPreferences?
  experiences      Experience[]
  education        Education[]
  certifications   Certification[]
  skills           Skill[]
  projects         Project[]
  achievements     Achievement[]
  links            Link[]
  sourcePostings   SourcePosting[]
  jobClusters      JobCluster[]
  jobPostings      JobPosting[]

  @@map("users")
}

// A group of Source Postings that represent the same real-world job
// (CONTEXT.md), collapsed into one canonical Job Posting. Deduplication
// signals are decided in 0003-deterministic-first-matching — company,
// title, location, canonical application URL, external job ID.
model JobCluster {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcePostings SourcePosting[]
  jobPosting     JobPosting?
  createdAt      DateTime        @default(now())
  lastUpdated    DateTime        @updatedAt

  @@index([userId])
  @@map("job_clusters")
}

// The raw, as-fetched data for a job from a single source (CONTEXT.md).
// Never mutated after creation — normalization reads from this, it doesn't
// write back to it. rawData is exactly what the source/adapter received.
// Belongs to a JobCluster — the cluster's sourcePostings are how a Job
// Posting exposes where it actually came from, possibly more than one place.
model SourcePosting {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobClusterId String
  jobCluster   JobCluster @relation(fields: [jobClusterId], references: [id], onDelete: Cascade)
  source       String
  sourceJobId  String
  rawData      Json
  fetchedAt    DateTime   @default(now())

  @@index([userId])
  @@index([jobClusterId])
  @@map("source_postings")
}

// The canonical, normalized Job Posting (CONTEXT.md) — one per JobCluster,
// not one per SourcePosting (that 1:1 was ticket 04's simplification before
// dedup existed). Field set follows PRD §9, with salary flattened into
// salaryMin/salaryMax/salaryCurrency scalars rather than PRD's nested
// { min, max, currency } object — same data, flat columns. No source/
// sourceJobId fields here: a cluster can hold postings from more than one
// source, so a single source/id pair on the canonical posting would be
// misleading — that provenance lives on each SourcePosting instead.
model JobPosting {
  id                      String     @id @default(uuid())
  userId                  String
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobClusterId            String     @unique
  jobCluster              JobCluster @relation(fields: [jobClusterId], references: [id], onDelete: Cascade)
  company                 String
  title                   String
  description             String
  location                String[]   @default([])
  remoteType              String?
  employmentType          String?
  salaryMin               Int?
  salaryMax               Int?
  salaryCurrency          String?
  seniority               String?
  skills                  String[]   @default([])
  // Populated by adapters (or left empty, e.g. ManualPasteAdapter today) —
  // not the structured Requirement records below. Relation named
  // `extractedRequirements` to avoid colliding with this pre-existing field.
  requirements            String[]   @default([])
  preferredQualifications String[]   @default([])
  educationRequirements   String[]   @default([])
  experienceRequirements  String[]   @default([])
  applicationUrl          String?
  postedAt                DateTime?
  deadline                DateTime?
  sourceUpdatedAt         DateTime?
  lastUpdated             DateTime   @updatedAt
  createdAt               DateTime   @default(now())
  extractedRequirements   Requirement[]

  @@index([userId])
  @@map("job_postings")
}

// A single skill, qualification, or expectation extracted from a Job
// Posting's description (CONTEXT.md's Requirement). Produced once, when the
// Job Posting is first created — a merged cluster reuses the existing Job
// Posting (see JobNormalizationService) so its Requirements aren't
// re-extracted. category is one of RequirementCategory (ticket 06); kept as
// a plain string, same convention as `source`/`provenance` fields elsewhere
// in this schema rather than a Prisma enum.
model Requirement {
  id           String     @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  category     String
  text         String
  createdAt    DateTime   @default(now())

  @@index([jobPostingId])
  @@map("requirements")
}

// The flat, singleton part of a Candidate Profile (CONTEXT.md). List-type
// facts (experience, skills, etc.) live in their own tables below — each row
// there is itself a piece of Candidate Evidence.
model CandidateProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName            String?
  contactEmail        String?
  phone               String?
  location            String?
  workAuthorization   String?
  professionalSummary String?
  source              String   @default("user_profile")
  verified            Boolean  @default(true)
  lastUpdated         DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@map("candidate_profiles")
}

// Job Preferences (CONTEXT.md): the user's configured search criteria that
// gate Job Discovery and score Matching. Singleton per user, like
// CandidateProfile — but unlike it, GET auto-creates defaults rather than
// 404ing, since discovery/matching (later tickets) should always have
// something to read even before the user has customized anything.
model JobPreferences {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRoles           String[] @default([])
  seniority             String[] @default([])
  locations             String[] @default([])
  remotePreference      Boolean  @default(false)
  hybridPreference      Boolean  @default(false)
  minimumSalaryAmount   Int?
  minimumSalaryCurrency String?
  employmentTypes       String[] @default([])
  requiredTechnologies  String[] @default([])
  preferredTechnologies String[] @default([])
  excludedCompanies     String[] @default([])
  excludedTitles        String[] @default([])
  keywords              String[] @default([])
  negativeKeywords      String[] @default([])
  lastUpdated           DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@map("job_preferences")
}

model Experience {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  source      String    @default("user_profile")
  verified    Boolean   @default(true)
  lastUpdated DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("experiences")
}

model Education {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  source       String    @default("user_profile")
  verified     Boolean   @default(true)
  lastUpdated  DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("education")
}

model Certification {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  issuer         String
  issueDate      DateTime?
  expirationDate DateTime?
  source         String    @default("user_profile")
  verified       Boolean   @default(true)
  lastUpdated    DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@map("certifications")
}

model Skill {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  source      String   @default("user_profile")
  verified    Boolean  @default(true)
  lastUpdated DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("skills")
}

model Project {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  technologies String[] @default([])
  source       String   @default("user_profile")
  verified     Boolean  @default(true)
  lastUpdated  DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("projects")
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  source      String   @default("user_profile")
  verified    Boolean  @default(true)
  lastUpdated DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("achievements")
}

model Link {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  url         String
  source      String   @default("user_profile")
  verified    Boolean  @default(true)
  lastUpdated DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("links")
}
